{
    "name": "zana/database",
    "description": "Database abstraction with connections and migrations for Zana applications",
    "type": "library",
    "keywords": ["zana", "database", "db", "pdo", "migrations"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "zana/console": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Database\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

