{
    "name": "mj-zana/database",
    "description": "PDO connections, query builder, schema builder, migrations and unit of work for Zana applications",
    "type": "library",
    "keywords": ["zana", "database", "pdo", "query-builder", "migrations", "schema"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "mj-zana/console": "^2.0",
        "mj-zana/core": "^2.4",
        "mj-zana/ddd": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-pdo_sqlite": "For SQLite connections",
        "ext-pdo_mysql": "For MySQL and MariaDB connections",
        "ext-pdo_pgsql": "For PostgreSQL connections"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Database\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.4.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.4.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.4.0" } } },
        { "type": "path", "url": "../zana-console", "options": { "symlink": true, "versions": { "mj-zana/console": "2.4.0" } } },
        { "type": "path", "url": "../zana-ddd", "options": { "symlink": true, "versions": { "mj-zana/ddd": "2.4.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
